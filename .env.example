# Neon PostgreSQL connection string (required)
# Get it from: https://console.neon.tech
DATABASE_URL=

# Chat model provider.
# Use "openai" with OPENAI_API_KEY for direct OpenAI model switching.
# Use "gateway" with AI_GATEWAY_API_KEY for Vercel AI Gateway.
CHAT_PROVIDER=openai
OPENAI_API_KEY=
CHAT_MODEL=gpt-5.1
